  "sourceProof": {
    "checks": [
      "changes join alerts by change_id and currency by evidence_id; baseline is last returned snapshot, not full history",
      "UNFIXED: disabled applicable rule included; global price rule borrows selected currency",
      "UNFIXED: optional list rules failure silently becomes []; rules route instead shows error",
      "create first two steps zero request; exact optional omission; conflict retains step3; close/reopen retains fields",
      "rule availability omits threshold; global numeric target null with zero preserved; new open resets defaults; conflicts retain input",
      "delete trims required reason and uses revision7, failed input retained, reopen clears; toggle uses exact status/revision",
      "task:create independent from competitor:manage; task intent binds evidence/change, no competitor mutation",
      "collect acceptance is queued not snapshot success; current-row polling keeps new task over stale response; unmount clears inert timer",
      "deep-linked selected item remains visible despite search; new search clears competitor/create query"
    ],
    "limits": "Real setup functions only; readiness helper inert, no template mount, HTTP, authorization, SQL, worker, notification, history lifecycle or race closure."
  },
  "boundaryProof": {
    "source": "apps/web/src/components/CompetitorMonitor.vue",
    "sourceSha256": "85f93c9f0e62a3152e36c6da6f1e852c57e23403c46d12f56814ca8141696657",
    "checks": [
      {
        "id": "CP-B01",
        "status": "UNFIXED-reproduced",
        "result": "P20 manager create+competitor query opens both flags; Escape closes rule then create. P19 only create. Read-only opens neither; no writes."
      },
      {
        "id": "CP-B02",
        "status": "fixed-source-regression",
        "result": "Late A detail success/failure cannot replace newer B selection/query/feedback; read generation enforced."
      },
      {
        "id": "CP-B03",
        "status": "fixed-source-regression",
        "result": "Collect A updates only A, without B feedback/poll; A and B pending tasks survive independent stale details, exact terminal A clears only A, unmount clears inert timer."
      },
      {
        "id": "CP-B04",
        "status": "UNFIXED-reproduced",
        "result": "Function-level A delete completion clears a newer B dialog/draft and reload clears success notice. Only A DELETE intended; DOM reachability/SQL unproven."
      },
      {
        "id": "CP-B05",
        "status": "UNFIXED-reproduced",
        "result": "Direct re-entry of createRule issues two request intents despite busy; disabled button, actual Enter/double-click and server idempotency are not tested."
      }
    ],
    "limits": "Actual setup with inert router/transport/timers; no Vue mount, real permission/HTTP/idempotency/SQL/Worker/production assertion. UNFIXED assertions must be replaced by desired-behavior regressions when implementing fixes."
  },
