  "sourceProof": {
    "checks": [
      "login exact payload; relative redirect bypasses landing",
      "non-relative redirect falls back to actual landing; no claim of complete redirect security",
      "challenge branch and invalid challenge clears code and returns login",
      "seed password 204 returns login before MFA; does not auto-enter business",
      "register mismatch zero request; exact body excludes confirmation; inline verify without navigation",
      "forgot generic acceptance does not confirm account or delivery",
      "verify no-token zero request; data-bearing response success (transport status not simulated)",
      "reset missing token still submitted by current source; 204 no automatic navigation, only one new password",
      "known source gap: false initial MFA flag survives read failure; draft must show unknown",
      "MFA enrollment/confirm/disable exact methods and bodies; source retains materials after disable, no cookie proof",
      "source mode switch retains sensitive refs; draft is not a lifecycle/security fix",
      "empty organizations provision no body; default onboarding return replaced with home",
      "workspace/team reads, archived zero write, exact context body and explicit continue boundary",
      "chooser expiry/forbidden/other failure separated",
      "root restores member path, blocks missing route, redirects expiry",
      "guide legal steps and known fractional-query undefined gap; not fixed in product"
    ],
    "count": 16,
    "scope": "actual Vue setup functions with isolated transport/router; no Vue mount, HTML constraint, cookie, auth, SQL, race or production proof"
  },
  "checks": [
    "1440: registration empty/mismatch and inline queued result, focus transfer",
    "1440: eight local form transitions via keyboard; synthetic materials only, no field values in event log",
    "1440: search/clear, organization/workspace, archived disabled, explicit continue vs personal auto-home",
    "1440: guide navigation/aria-current/root exit",
    "1440: seven auxiliary route targets and chosen organization name remain consistent",
    "1440: four control families hover/focus/pressed screenshots; six widths, 200% zoom, 16px controls/44px touch, no dialogs, no cookie/storage writes",
    "390: registration empty/mismatch and inline queued result, focus transfer",
    "390: eight local form transitions via keyboard; synthetic materials only, no field values in event log",
