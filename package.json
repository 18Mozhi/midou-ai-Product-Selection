{
  "name": "midou-ai-product-selection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "locate:flow": "node scripts/locate_flow_v4.mjs",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json",
    "build:config": "tsc -p packages/config/tsconfig.json",
    "build:database": "tsc -p packages/database/tsconfig.json",
    "build:redis": "tsc -p packages/redis/tsconfig.json",
    "build:storage": "tsc -p packages/storage/tsconfig.json",
    "build:credentials": "tsc -p packages/credentials/tsconfig.json",
    "build:provider-adapters": "tsc -p packages/provider-adapters/tsconfig.json",
    "build:playwright-crawler": "tsc -p packages/playwright-crawler/tsconfig.json",
    "build:collection-tasks": "tsc -p packages/collection-tasks/tsconfig.json",
    "build:data-quality": "tsc -p packages/data-quality/tsconfig.json",
    "build:runtime-topology": "tsc -p packages/runtime-topology/tsconfig.json",
    "build:provider-sources": "tsc -p packages/provider-sources/tsconfig.json",
    "build:auth": "tsc -p packages/auth/tsconfig.json",
    "build:tenancy": "tsc -p packages/tenancy/tsconfig.json",
    "build:authorization": "tsc -p packages/authorization/tsconfig.json",
    "build:resource-grants": "tsc -p packages/resource-grants/tsconfig.json",
    "build:audit": "tsc -p packages/audit/tsconfig.json",
    "build:preferences": "tsc -p packages/preferences/tsconfig.json",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "build:backend": "tsc -p apps/backend/tsconfig.json",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "build:browser-helper": "node scripts/build-browser-helper.mjs",
    "build:web": "npm run build:browser-helper && npm run typecheck:web && vite build --config apps/web/vite.config.ts",
    "build": "node scripts/build-workspaces.mjs",
    "start:backend": "node apps/backend/dist/server.js",
    "start:e2e-api": "npm run build:contracts && npm run build:api && node scripts/run-playwright-api-test-server.mjs",
    "dev:api": "npm run build:contracts && node --watch apps/api/dist/server.js",
    "dev:worker": "npm run build:contracts && node --watch apps/worker/dist/index.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "test:unit": "npm run build:contracts && npm run build:provider-sources && npm run build:api && npm run build:worker && node --test tests/unit/*.test.mjs",
    "test:contract": "npm run build:contracts && npm run build:api && node --test tests/contracts/*.test.mjs",
    "test:integration": "npm run build:contracts && npm run build:credentials && npm run build:playwright-crawler && npm run build:api && npm run build:worker && node --test tests/integration/*.test.mjs",
    "test:python": "python -m unittest discover -s apps/crawler/tests -p \"test_*.py\"",
    "verify:module": "node scripts/verify-module.mjs",
    "verify:phase": "node scripts/verify-phase.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:functional": "node scripts/verify-functional.mjs",
    "verify:production-product": "node scripts/verify-production-product.mjs",
    "verify:production-core-e2e": "node scripts/verify-production-core-e2e.mjs",
    "verify:production-acceptance": "node scripts/run-baota-production-acceptance.mjs",
    "generate:route-artifacts": "node scripts/generate-route-artifacts.mjs --write",
    "verify:route-artifacts": "node scripts/generate-route-artifacts.mjs --check",
    "verify:release-matrix": "node scripts/verify-release-matrix.mjs --validate",
    "verify:release-ownership": "node scripts/verify-release-change-ownership.mjs --manifest .artifacts/release-change-ownership.json",
    "verify:runtime-docs": "node scripts/verify-runtime-doc-consistency.mjs",
    "verify:security-gate": "node scripts/verify-security-gate.mjs",
    "verify:docs": "npm run verify:route-artifacts && node scripts/verify-docs.mjs",
    "format:check": "node scripts/verify-code-style.mjs --check",
    "format:write": "node scripts/verify-code-style.mjs --write",
    "verify:code-style": "npm run format:check",
    "verify:static-analysis": "node scripts/verify-static-analysis.mjs",
    "verify:frontend-budget": "node scripts/verify-frontend-budget.mjs",
    "verify:e2e-realism": "node scripts/verify-e2e-realism.mjs",
    "verify:crawler-chain": "node scripts/verify-crawler-production-chain.mjs",
    "verify:plans": "node scripts/verify-plans.mjs",
    "test:e2e": "node scripts/run-playwright-projects.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "fastify": "^5.6.2",
    "mysql2": "^3.15.3",
    "playwright": "^1.58.2",
    "redis": "^5.12.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  }
}
