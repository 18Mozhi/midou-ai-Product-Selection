{
  "manifest_version": 3,
  "name": "ai选品浏览器助手",
  "version": "1.0.1",
  "description": "按用户选择的来源读取 Cookie，并从已登录的 ERP 商品列表导入真实商品数据。",
  "permissions": ["cookies", "scripting", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": [
        "https://midouai.medouai.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "ai选品浏览器助手" }
}
