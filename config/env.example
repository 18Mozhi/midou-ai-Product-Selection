# Copy to .env for local development. Do not commit real values.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4101
APP_VERSION=0.1.0
BUILD_SHA=development
WEB_ORIGIN=http://127.0.0.1:5173
# 浏览器仅允许读取此前缀的 API 地址；不得添加 DB、Redis、AI 或密钥配置。
VITE_API_BASE_URL=/api/v1

WORKER_ID=worker-local
CRAWLER_ID=crawler-local
WORKER_HEARTBEAT_MS=30000
CRAWLER_HEARTBEAT_SECONDS=30

# 验收命令只在本地/CI/宝塔受控发布任务执行；报告目录必须位于项目内。
VERIFY_COMMAND_TIMEOUT_MS=120000
VERIFY_REPORT_DIR=.artifacts/verification

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=product_scout
DB_USER=product_scout
DB_PASSWORD=
# S1+ 读写分离时使用；S0 保持空值并回退到 DB_HOST。
DB_WRITE_HOST=
DB_READ_HOST=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 连接建立超时，100–30000 毫秒；修改后需在宝塔重启使用 Redis 的进程。
REDIS_CONNECT_TIMEOUT_MS=3000

AI_BASE_URL=http://192.168.1.203:8588/v1
AI_MODEL=Qwen3.5-9B-AWQ-4bit
AI_API_KEY=
AI_TIMEOUT_MS=30000

EVIDENCE_ROOT=./runtime/evidence
EXPORT_ROOT=./runtime/exports
SESSION_SECRET=
# AES-256-GCM 主密钥；仅在宝塔受限运行环境中配置，不能提交真实值。
CREDENTIALS_MASTER_KEY=
GITHUB_REPOSITORY=18Mozhi/midou-ai-Product-Selection
