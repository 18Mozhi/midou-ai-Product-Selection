# Copy to .env for local development. Do not commit real values.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4101
APP_VERSION=0.1.0
BUILD_SHA=development
WEB_ORIGIN=http://127.0.0.1:5173
# 浏览器仅允许读取此前缀的 API 地址；不得添加 DB、Redis、AI 或密钥配置。
VITE_API_BASE_URL=/api/v1

WORKER_ID=worker-local
CRAWLER_ID=crawler-local
WORKER_HEARTBEAT_MS=30000
CRAWLER_HEARTBEAT_SECONDS=30

# M03-05 采集任务调度。修改后须在宝塔面板重启 Node Worker；总尝试次数 4 次和 1/5/15 分钟退避是锁定业务规则，不开放环境变量。
COLLECTION_TASK_POLL_MS=2000
COLLECTION_TASK_LEASE_SECONDS=120

# M04-01 趋势投影 Worker；修改后须在宝塔面板重启 Node Worker。
TREND_PROJECTION_POLL_MS=2000
TREND_PROJECTION_LEASE_SECONDS=120

# M04-02/M04-03/M04-04 机会证据刷新、评分与利润计算队列；修改后须在宝塔面板重启 Node Worker。
OPPORTUNITY_REFRESH_POLL_MS=2000
OPPORTUNITY_REFRESH_LEASE_SECONDS=120
OPPORTUNITY_SCORING_POLL_MS=2000
OPPORTUNITY_SCORING_LEASE_SECONDS=120
PROFIT_CALCULATION_POLL_MS=2000
PROFIT_CALCULATION_LEASE_SECONDS=120

# M04-05 竞品快照比较与阈值告警队列；修改后须在宝塔面板重启 Node Worker。
COMPETITOR_MONITOR_POLL_MS=2000
COMPETITOR_MONITOR_LEASE_SECONDS=120

# M04-06 供应链已完成采集任务投影；修改后须在宝塔面板重启 Node Worker。
SOURCING_PROJECTION_POLL_MS=2000
SOURCING_PROJECTION_LEASE_SECONDS=120

# M05-01 将 M04-06 采购任务 Outbox 投影为业务任务；修改后须在宝塔面板重启 Node Worker。
BUSINESS_TASK_PROJECTION_POLL_MS=2000
BUSINESS_TASK_PROJECTION_LEASE_SECONDS=120

# M05-02 审批节点超时升级；修改后须在宝塔面板重启 Node Worker。
APPROVAL_ESCALATION_POLL_MS=2000
APPROVAL_ESCALATION_LEASE_SECONDS=120

# M05-03 全局 Outbox 转站内通知；邮件固定 placeholder，不会发送真实邮件。修改后在宝塔重启 Node Worker。
NOTIFICATION_OUTBOX_POLL_MS=2000
NOTIFICATION_OUTBOX_LEASE_SECONDS=120
NOTIFICATION_OUTBOX_RETRY_LIMIT=3
NOTIFICATION_EMAIL_DELIVERY_MODE=placeholder

# M05-04 S0 单机 SSE；修改后在宝塔重启 Node API。P08 前不代表多节点能力。
REALTIME_POLL_MS=1000
REALTIME_HEARTBEAT_MS=15000
REALTIME_REPLAY_LIMIT=100
REALTIME_MAX_CONNECTION_SECONDS=55
REALTIME_MAX_CONNECTIONS=200

# M05-05 自动化规则（仅宝塔 Node Worker；S0 单主机）
AUTOMATION_POLL_MS=2000
AUTOMATION_LEASE_SECONDS=120
AUTOMATION_RETRY_LIMIT=3
AUTOMATION_DEFAULT_RATE_LIMIT=20

# M05-06 报表导出（API/Worker 同一宝塔受限目录）
REPORT_EXPORT_POLL_MS=2000
REPORT_EXPORT_LEASE_SECONDS=120
REPORT_EXPORT_RETRY_LIMIT=3
REPORT_EXPORT_TTL_HOURS=24
REPORT_EXPORT_MAX_ROWS=10000
REPORT_EXPORT_ROOT=./data/report-exports

# M06-01 组织后台；修改后需在宝塔重启 Node API。邮件 Provider 未确认，邀请只进入待投递状态。
ORG_INVITATION_TTL_HOURS=72
ORG_TOKEN_DEFAULT_TTL_DAYS=90
ORG_TOKEN_MAX_ACTIVE=20

# M03-06 原始证据与受控下载；目录须由宝塔限制为中国境内本机存储，修改后重启 Node API/Worker。
EVIDENCE_MAX_RAW_BYTES=10485760
EVIDENCE_DOWNLOAD_GRANT_SECONDS=120
EVIDENCE_DOWNLOAD_SIGNING_KEY=

# 验收命令只在本地/CI/宝塔受控发布任务执行；报告目录必须位于项目内。
VERIFY_COMMAND_TIMEOUT_MS=120000
VERIFY_REPORT_DIR=.artifacts/verification

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=product_scout
DB_USER=product_scout
DB_PASSWORD=
# S1+ 读写分离时使用；S0 保持空值并回退到 DB_HOST。
DB_WRITE_HOST=
DB_READ_HOST=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 连接建立超时，100–30000 毫秒；修改后需在宝塔重启使用 Redis 的进程。
REDIS_CONNECT_TIMEOUT_MS=3000

AI_BASE_URL=http://192.168.1.203:8588/v1
AI_MODEL=Qwen3.5-9B-AWQ-4bit
AI_API_KEY=
AI_TIMEOUT_MS=30000
# M04-07 AI 辅助分析仅由宝塔 Node Worker 调用；JSON 输出会再次做本地 schema 校验。
AI_RETRY_LIMIT=3
AI_ANALYSIS_POLL_MS=2000
AI_ANALYSIS_LEASE_SECONDS=120

EVIDENCE_ROOT=./runtime/evidence
EXPORT_ROOT=./runtime/exports
# Worker/Crawler 仅在授权任务期间写入的受限临时目录；任务 finally 必须删除明文。
CREDENTIAL_TEMP_ROOT=./runtime/credential-tmp
SESSION_SECRET=
# AES-256-GCM 主密钥；仅在宝塔受限运行环境中配置，不能提交真实值。
CREDENTIALS_MASTER_KEY=
# 当前主密钥的非秘密版本标签；更换主密钥前先按 M03-02 Runbook 完成重加密。
CREDENTIALS_MASTER_KEY_VERSION=v1
# 仅在宝塔受限的一次性主密钥轮换任务中注入；完成重加密和常驻配置切换后立即删除。
CREDENTIALS_ROTATION_NEW_MASTER_KEY=
CREDENTIALS_ROTATION_NEW_KEY_VERSION=
CREDENTIALS_ROTATION_ACTOR_ID=

# Provider 适配器统一运行上限；API/Worker 配置变更后需由宝塔重启对应项目。
# M03-07 首批来源复用这三个启动校验：Google RSS 每批再收紧为 20 条/2MB，CSV 再收紧为 20 条/1MB；固定 URL 在代码目录中，不接受环境变量或请求覆盖。
PROVIDER_ADAPTER_HEALTH_TIMEOUT_MS=10000
PROVIDER_ADAPTER_MAX_RESPONSE_BYTES=5242880
PROVIDER_ADAPTER_MAX_ITEMS_PER_BATCH=500

# M03-04 Playwright Crawler；真实浏览器进程仍由宝塔 Python Crawler 项目触发和管理。
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_ACTION_TIMEOUT_MS=10000
PLAYWRIGHT_MAX_PAGES=10
PLAYWRIGHT_MAX_SCROLLS=20
PLAYWRIGHT_MAX_DETAILS=20
PLAYWRIGHT_PROFILE_ARCHIVE_MAX_BYTES=104857600
PLAYWRIGHT_PROFILE_EXTRACTED_MAX_BYTES=524288000
PLAYWRIGHT_PROFILE_MAX_FILES=5000
PLAYWRIGHT_NODE_BINARY=node
PLAYWRIGHT_RUNNER_PATH=../../scripts/run-playwright-crawler.mjs
PLAYWRIGHT_RUN_TIMEOUT_SECONDS=180

# 本地账号安全策略；Argon2id 下限来自 OWASP。生产调整后需在宝塔重启 API/Worker。
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_SESSION_TTL_MINUTES=720
AUTH_ACTION_TOKEN_TTL_MINUTES=15
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_OUTBOX_POLL_MS=5000

# TOTP MFA 遵循 RFC 6238；因子密文复用 CREDENTIALS_MASTER_KEY。修改后需在宝塔重启 API。
MFA_ISSUER=ScoutOps
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1
MFA_CHALLENGE_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=8

# 仅在宝塔受限的一次性发布任务中临时注入。成功后必须删除这两个变量；常驻 API/Worker 不读取它们。
PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=

# 平台驾驶舱读模型；修改后由宝塔重启 Node API。阈值仅改变告警状态，不改变任务处理。
PLATFORM_DASHBOARD_DEFAULT_WINDOW=24h
PLATFORM_DASHBOARD_QUEUE_WARNING=1000
PLATFORM_DASHBOARD_ERROR_LIMIT=20
GITHUB_REPOSITORY=18Mozhi/midou-ai-Product-Selection
