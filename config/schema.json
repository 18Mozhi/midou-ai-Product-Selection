{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOps runtime environment",
  "version": 1,
  "browserAllowlist": ["VITE_API_BASE_URL"],
  "backendGroups": {
    "app": ["NODE_ENV", "APP_HOST", "APP_PORT", "APP_VERSION", "BUILD_SHA", "WEB_ORIGIN"],
    "database": ["DB_HOST", "DB_PORT", "DB_NAME", "DB_USER", "DB_PASSWORD", "DB_WRITE_HOST", "DB_READ_HOST"],
    "redis": ["REDIS_HOST", "REDIS_PORT", "REDIS_PASSWORD", "REDIS_CONNECT_TIMEOUT_MS"],
    "ai": ["AI_BASE_URL", "AI_MODEL", "AI_API_KEY", "AI_TIMEOUT_MS"],
    "storage": ["EVIDENCE_ROOT", "EXPORT_ROOT"],
    "runtime": ["WORKER_ID", "CRAWLER_ID", "WORKER_HEARTBEAT_MS", "CRAWLER_HEARTBEAT_SECONDS"],
    "security": ["SESSION_SECRET", "CREDENTIALS_MASTER_KEY"]
  },
  "secretKeys": ["DB_PASSWORD", "REDIS_PASSWORD", "AI_API_KEY", "SESSION_SECRET", "CREDENTIALS_MASTER_KEY"],
  "productionRequired": ["DB_PASSWORD", "SESSION_SECRET", "CREDENTIALS_MASTER_KEY"]
}
