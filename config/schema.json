{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOps runtime environment",
  "version": 1,
  "browserAllowlist": ["VITE_API_BASE_URL"],
  "backendGroups": {
    "app": ["NODE_ENV", "APP_HOST", "APP_PORT", "APP_VERSION", "BUILD_SHA", "WEB_ORIGIN"],
    "database": ["DB_HOST", "DB_PORT", "DB_NAME", "DB_USER", "DB_PASSWORD", "DB_WRITE_HOST", "DB_READ_HOST"],
    "redis": ["REDIS_HOST", "REDIS_PORT", "REDIS_PASSWORD", "REDIS_CONNECT_TIMEOUT_MS"],
    "ai": ["AI_BASE_URL", "AI_MODEL", "AI_API_KEY", "AI_TIMEOUT_MS"],
    "storage": ["EVIDENCE_ROOT", "EXPORT_ROOT", "CREDENTIAL_TEMP_ROOT"],
    "runtime": ["WORKER_ID", "CRAWLER_ID", "WORKER_HEARTBEAT_MS", "CRAWLER_HEARTBEAT_SECONDS"],
    "collectionTasks": ["COLLECTION_TASK_POLL_MS", "COLLECTION_TASK_LEASE_SECONDS"],
    "trends": ["TREND_PROJECTION_POLL_MS", "TREND_PROJECTION_LEASE_SECONDS"],
    "opportunities": ["OPPORTUNITY_REFRESH_POLL_MS", "OPPORTUNITY_REFRESH_LEASE_SECONDS", "OPPORTUNITY_SCORING_POLL_MS", "OPPORTUNITY_SCORING_LEASE_SECONDS"],
    "evidence": ["EVIDENCE_MAX_RAW_BYTES", "EVIDENCE_DOWNLOAD_GRANT_SECONDS", "EVIDENCE_DOWNLOAD_SIGNING_KEY"],
    "providerAdapters": ["PROVIDER_ADAPTER_HEALTH_TIMEOUT_MS", "PROVIDER_ADAPTER_MAX_RESPONSE_BYTES", "PROVIDER_ADAPTER_MAX_ITEMS_PER_BATCH"],
    "playwrightCrawler": ["PLAYWRIGHT_HEADLESS", "PLAYWRIGHT_NAVIGATION_TIMEOUT_MS", "PLAYWRIGHT_ACTION_TIMEOUT_MS", "PLAYWRIGHT_MAX_PAGES", "PLAYWRIGHT_MAX_SCROLLS", "PLAYWRIGHT_MAX_DETAILS", "PLAYWRIGHT_PROFILE_ARCHIVE_MAX_BYTES", "PLAYWRIGHT_PROFILE_EXTRACTED_MAX_BYTES", "PLAYWRIGHT_PROFILE_MAX_FILES", "PLAYWRIGHT_NODE_BINARY", "PLAYWRIGHT_RUNNER_PATH", "PLAYWRIGHT_RUN_TIMEOUT_SECONDS"],
    "security": ["SESSION_SECRET", "CREDENTIALS_MASTER_KEY", "CREDENTIALS_MASTER_KEY_VERSION"],
    "auth": ["AUTH_ARGON2_MEMORY_KIB", "AUTH_ARGON2_TIME_COST", "AUTH_ARGON2_PARALLELISM", "AUTH_PASSWORD_MIN_LENGTH", "AUTH_PASSWORD_MAX_LENGTH", "AUTH_SESSION_TTL_MINUTES", "AUTH_ACTION_TOKEN_TTL_MINUTES", "AUTH_MAX_FAILED_ATTEMPTS", "AUTH_LOCK_MINUTES", "AUTH_OUTBOX_POLL_MS"],
    "mfa": ["MFA_ISSUER", "MFA_TOTP_PERIOD_SECONDS", "MFA_TOTP_DIGITS", "MFA_TOTP_WINDOW", "MFA_CHALLENGE_TTL_MINUTES", "MFA_MAX_ATTEMPTS", "MFA_RECOVERY_CODE_COUNT"],
    "oneTimeSeed": ["PLATFORM_ADMIN_SEED_EMAIL", "PLATFORM_ADMIN_SEED_PASSWORD"],
    "oneTimeCredentialRotation": ["CREDENTIALS_ROTATION_NEW_MASTER_KEY", "CREDENTIALS_ROTATION_NEW_KEY_VERSION", "CREDENTIALS_ROTATION_ACTOR_ID"]
  },
  "secretKeys": ["DB_PASSWORD", "REDIS_PASSWORD", "AI_API_KEY", "SESSION_SECRET", "CREDENTIALS_MASTER_KEY", "EVIDENCE_DOWNLOAD_SIGNING_KEY", "PLATFORM_ADMIN_SEED_PASSWORD", "CREDENTIALS_ROTATION_NEW_MASTER_KEY"],
  "productionRequired": ["DB_PASSWORD", "SESSION_SECRET", "CREDENTIALS_MASTER_KEY", "EVIDENCE_DOWNLOAD_SIGNING_KEY"]
}
