{
  "schemaVersion": 3,
  "stage": "production",
  "deploymentStatus": "healthy",
  "productionDeployed": true,
  "target": {
    "host": "192.168.1.220",
    "domain": "midouai.mozhiz.cn",
    "deployRoot": "/www/wwwroot/ai选品",
    "primaryRegion": "惠州",
    "recoveryRegion": "惠州",
    "publicPorts": [80, 443],
    "privatePorts": [4101, 3306, 6379]
  },
  "runtimeClaim": "惠州单机、单一宝塔 Node 后端；只声明真实功能和当前运行健康，不声明负载均衡、多节点或硬件容量。",
  "objects": [
    {
      "name": "ai选品网站",
      "kind": "baota-site",
      "workingDirectory": "/www/wwwroot/ai选品/current",
      "buildCommand": "npm ci && npm run build",
      "publishDirectory": "apps/web/dist",
      "domain": "midouai.mozhiz.cn",
      "public": true,
      "healthPath": "/",
      "nginxTemplate": "infra/baota/nginx/scoutops.conf.template"
    },
    {
      "name": "ai选品",
      "kind": "baota-node-project",
      "workingDirectory": "/www/wwwroot/ai选品/current",
      "startCommand": "node apps/backend/dist/server.js",
      "processMode": "foreground",
      "bind": "127.0.0.1",
      "port": 4101,
      "public": false,
      "healthPaths": ["/api/v1/health/live", "/api/v1/health/ready", "/api/v1/health/version"],
      "managedChildren": ["api", "worker"],
      "environmentGroups": ["app", "database", "redis", "ai", "storage", "runtime", "security", "auth", "mfa", "realtime", "evidence", "providerAdapters", "playwrightCrawler", "collectionTasks", "trends", "opportunities", "competitorMonitor", "sourcing", "businessTasks", "approvals", "notifications", "platformDashboard", "collectionConsole", "securityOperations", "openPlatform", "commercial", "backupRecovery", "fileResilience"],
      "logSource": "stdout/stderr",
      "gracefulSignals": ["SIGTERM", "SIGINT"]
    },
    {
      "name": "ai选品数据库",
      "kind": "baota-mysql-service",
      "version": "5.7",
      "database": "product_scout",
      "account": "product_scout",
      "charset": "utf8mb4",
      "bind": "127.0.0.1",
      "public": false
    },
    {
      "name": "ai选品缓存",
      "kind": "baota-redis-service",
      "bind": "127.0.0.1",
      "public": false,
      "purposes": ["cache", "queue", "rate", "sse"]
    },
    {
      "name": "ai选品备份",
      "kind": "baota-backup-task",
      "targets": ["product_scout database", "EVIDENCE_ROOT", "EXPORT_ROOT"],
      "recoveryRegion": "惠州",
      "public": false
    }
  ],
  "restrictedConfig": {
    "source": "config/env.example and config/schema.json",
    "secretValuesInManifest": false,
    "browserAllowlist": ["VITE_API_BASE_URL"]
  },
  "logging": {
    "managedInBaota": true,
    "sources": ["site access/error", "ai选品 stdout/stderr", "MySQL", "Redis", "backup task"],
    "requiredFields": ["service", "status", "observed_at", "request_id or trace_id when request-scoped"],
    "forbiddenFields": ["password", "cookie", "token", "api_key", "private_key", "master_key"]
  },
  "productionEvidence": {
    "schema": "verification/baota-production-evidence.schema.json",
    "path": ".artifacts/verification/baota-production-evidence.json",
    "requiredBeforeDeployed": true
  },
  "forbiddenProductionManagers": ["systemd", "standalone-pm2", "host-crontab", "screen-docker-compose"]
}
