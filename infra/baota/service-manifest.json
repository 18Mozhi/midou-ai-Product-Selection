{
  "schemaVersion": 2,
  "stage": "S0",
  "deploymentStatus": "healthy",
  "productionDeployed": true,
  "target": {
    "host": "192.168.1.220",
    "domain": "midouai.mozhiz.cn",
    "primaryRegion": "惠州",
    "recoveryRegion": "惠州",
    "publicPorts": [80, 443],
    "privatePorts": [4101, 4103, 3306, 6379]
  },
  "capacityClaim": "S0 single host; 100 users and 5-20 concurrent business users; no multi-node or 10000-user claim",
  "objects": [
    {
      "name": "product-scout-web",
      "kind": "baota-site",
      "workingDirectory": "<RELEASE_ROOT>",
      "buildCommand": "npm ci && npm run build:web",
      "publishDirectory": "apps/web/dist",
      "domain": "midouai.mozhiz.cn",
      "public": true,
      "healthPath": "/",
      "nginxTemplate": "infra/baota/nginx/scoutops.conf.template"
    },
    {
      "name": "product-scout-api",
      "kind": "baota-node-project",
      "workingDirectory": "<RELEASE_ROOT>",
      "startCommand": "node apps/api/dist/server.js",
      "bind": "127.0.0.1",
      "port": 4101,
      "public": false,
      "healthPaths": ["/api/v1/health/live", "/api/v1/health/ready", "/api/v1/health/version"],
      "environmentGroups": ["app", "database", "redis", "storage", "security", "auth", "mfa", "realtime", "evidence", "providerAdapters", "playwrightCrawler", "platformDashboard", "collectionConsole", "securityOperations", "openPlatform", "commercial", "backupRecovery", "releaseRollout", "fileResilience"],
      "logSource": "stdout/stderr",
      "gracefulSignals": ["SIGTERM", "SIGINT"]
    },
    {
      "name": "product-scout-worker",
      "kind": "baota-node-project",
      "workingDirectory": "<RELEASE_ROOT>",
      "startCommand": "node apps/worker/dist/index.js",
      "public": false,
      "environmentGroups": ["app", "database", "redis", "ai", "storage", "runtime", "collectionTasks", "trends", "opportunities", "competitorMonitor", "sourcing", "businessTasks", "approvals", "notifications", "providerAdapters", "playwrightCrawler", "security", "auth", "openPlatform"],
      "heartbeat": {"maximumAgeSeconds": 60, "service": "product-scout-worker"},
      "logSource": "stdout/stderr",
      "gracefulSignals": ["SIGTERM", "SIGINT"]
    },
    {
      "name": "product-scout-api-canary",
      "kind": "baota-node-project",
      "workingDirectory": "<CANDIDATE_RELEASE_ROOT>",
      "startCommand": "node apps/api/dist/server.js",
      "bind": "127.0.0.1",
      "port": 4103,
      "runtimeEnvironment": {"APP_PORT": 4103},
      "public": false,
      "purpose": "M07-05 same-host release slot B; stable and candidate roles alternate by audited release",
      "healthPaths": ["/api/v1/health/live", "/api/v1/health/ready", "/api/v1/health/version"],
      "environmentGroups": ["app", "database", "redis", "storage", "security", "auth", "mfa", "realtime", "evidence", "providerAdapters", "playwrightCrawler", "platformDashboard", "collectionConsole", "securityOperations", "openPlatform", "commercial", "backupRecovery", "releaseRollout", "fileResilience"],
      "logSource": "stdout/stderr",
      "gracefulSignals": ["SIGTERM", "SIGINT"]
    },
    {
      "name": "product-scout-crawler",
      "kind": "baota-python-project",
      "workingDirectory": "<RELEASE_ROOT>/apps/crawler",
      "startCommand": "python -m scoutops_crawler",
      "preflightCommand": "python -m scoutops_crawler --once",
      "public": false,
      "environmentGroups": ["runtime", "playwrightCrawler", "storage"],
      "heartbeat": {"maximumAgeSeconds": 60, "service": "product-scout-crawler"},
      "logSource": "stdout/stderr",
      "gracefulSignals": ["SIGTERM", "SIGINT"]
    },
    {
      "name": "mysql57-product-scout",
      "kind": "baota-mysql-service",
      "version": "5.7",
      "database": "product_scout",
      "account": "product_scout",
      "charset": "utf8mb4",
      "bind": "127.0.0.1",
      "public": false
    },
    {
      "name": "redis-product-scout",
      "kind": "baota-redis-service",
      "bind": "127.0.0.1",
      "public": false,
      "purposes": ["cache", "queue", "rate", "sse"]
    },
    {
      "name": "product-scout-release-gate",
      "kind": "baota-scheduled-task",
      "schedule": "manual-before-release",
      "workingDirectory": "<RELEASE_ROOT>",
      "command": "npm run verify:module -- M07-02",
      "public": false,
      "reportDirectory": ".artifacts/verification"
    },
    {
      "name": "product-scout-release-rollout",
      "kind": "baota-scheduled-task",
      "schedule": "manual-only-disabled-schedule",
      "concurrentRuns": 1,
      "lock": "mysql_session_named_lock",
      "lockName": "scoutops:m07-05:release-rollout",
      "workingDirectory": "<CANDIDATE_RELEASE_ROOT>",
      "command": "node scripts/run-baota-release-rollout.mjs --run --env-file <BAOTA_RESTRICTED_ENV_FILE>",
      "public": false,
      "reportDirectory": ".artifacts/verification"
    },
    {
      "name": "product-scout-backup",
      "kind": "baota-backup-task",
      "status": "owned-by-M07-04",
      "targets": ["product_scout database", "EVIDENCE_ROOT", "EXPORT_ROOT"],
      "recoveryRegion": "惠州",
      "public": false
    }
  ],
  "restrictedConfig": {
    "source": "config/env.example and config/schema.json",
    "secretValuesInManifest": false,
    "browserAllowlist": ["VITE_API_BASE_URL"]
  },
  "logging": {
    "managedInBaota": true,
    "sources": ["site access/error", "Node API stdout/stderr", "Node Worker stdout/stderr", "Python Crawler stdout/stderr", "MySQL", "Redis", "scheduled tasks"],
    "requiredFields": ["service", "status", "observed_at", "request_id or trace_id when request-scoped"],
    "forbiddenFields": ["password", "cookie", "token", "api_key", "private_key", "master_key"]
  },
  "productionEvidence": {
    "schema": "verification/baota-production-evidence.schema.json",
    "path": ".artifacts/verification/baota-production-evidence.json",
    "requiredBeforeDeployed": true
  },
  "forbiddenProductionManagers": ["systemd", "standalone-pm2", "host-crontab", "screen-docker-compose"]
}
