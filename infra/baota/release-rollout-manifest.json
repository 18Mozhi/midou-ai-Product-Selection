{
  "schemaVersion": 3,
  "module": "M07-05",
  "stage": "S0",
  "productionManager": "baota",
  "topology": "single-host-stable-and-candidate",
  "capacityClaim": "S0 single host only; no backup server, multi-node or 10000-user claim",
  "objects": [
    {
      "name": "product-scout-api",
      "kind": "baota-node-project",
      "role": "release-slot-a",
      "bind": "127.0.0.1",
      "port": 4101
    },
    {
      "name": "product-scout-api-canary",
      "kind": "baota-node-project",
      "role": "release-slot-b",
      "bind": "127.0.0.1",
      "port": 4103
    },
    {
      "name": "product-scout-release-rollout",
      "kind": "baota-scheduled-task",
      "schedule": "manual-release-gate",
      "command": "node scripts/run-baota-release-rollout.mjs --run --env-file <BAOTA_RESTRICTED_ENV_FILE>"
    }
  ],
  "canary": {
    "percentages": [5, 25, 100],
    "minimumObservationSeconds": 1800,
    "syntheticProbeIntervalSeconds": 1,
    "routingKey": "$request_id",
    "measurementSource": "baota-nginx-upstream-timing-log",
    "syntheticReadPath": "/api/v1/health/live",
    "syntheticWritePath": "/api/v1/platform/operations/releases/write-probe",
    "syntheticWriteCanonicalFields": ["timestamp", "nonce", "release_id", "sample_id"],
    "proxyRequestIdsExcludedFromSignature": true,
    "candidatePersistenceParityRequired": true,
    "transportDeliveryRetryAttempts": 1,
    "transportAbortRetryScope": "nginx-499-before-upstream-only",
    "candidateNon202RetryAllowed": false,
    "syntheticWriteContract": "proxy-safe HMAC over timestamp/nonce/release/sample, one durable MySQL autocommit statement, candidate 202 and persistence parity, immutable proxy request and trace audit",
    "minimumCandidateSamplesPerMethod": 5
  },
  "mysqlDurability": {
    "innodbFlushLogAtTrxCommit": 2,
    "syncBinlog": 1,
    "productScoutBinlogExcluded": true,
    "osCrashDataLossWindowSeconds": 1,
    "verificationAccount": "existing product_scout@127.0.0.1 account with global REPLICATION CLIENT",
    "authorization": "explicit user approval on 2026-08-10",
    "rollback": "restore the BaoTa-restricted my.cnf backup and restart MySQL through BaoTa"
  },
  "mysqlResourceProfile": {
    "innodbBufferPoolBytes": 4294967296,
    "innodbBufferPoolInstances": 4,
    "innodbIoCapacity": 1000,
    "innodbIoCapacityMax": 4000,
    "innodbFlushNeighbors": 0,
    "innodbFlushMethod": "O_DIRECT"
  },
  "automaticStop": {
    "errorRatePercentExclusive": 1,
    "readP95MsInclusive": 300,
    "writeP95MsInclusive": 600,
    "asyncLagSecondsInclusive": 60,
    "asyncQueueTables": [
      "auth_delivery_outbox",
      "collection_tasks",
      "trend_projection_jobs",
      "opportunity_refresh_jobs",
      "opportunity_score_jobs",
      "opportunity_profit_jobs",
      "competitor_snapshot_jobs",
      "sourcing_projection_jobs",
      "ai_analysis_requests",
      "sourcing_outbox",
      "approval_escalation_jobs",
      "outbox_events",
      "automation_executions",
      "report_exports",
      "webhook_deliveries"
    ],
    "asyncQueueScope": "only due work or expired leases claimed by the Baota-managed Node Worker; DATETIME(3) due and lag comparisons use the same MySQL session NOW(3) clock as the Worker; domain audit outboxes without a runtime consumer are excluded",
    "action": "route-100-percent-to-the-runtime-stable-slot-and-record-audited-rollback"
  },
  "nginx": {
    "managedConfigRoot": "/www/server/panel/vhost/nginx",
    "timingLog": "/www/wwwlogs/product-scout-release-upstream.log",
    "testCommand": "/www/server/nginx/sbin/nginx -t",
    "reloadCommand": "/www/server/nginx/sbin/nginx -s reload"
  },
  "restrictedConfig": {
    "source": "config/env.example and config/schema.json",
    "releaseProbeSigningKey": "Baota restricted API and rollout-task environment only",
    "secretValuesInManifest": false,
    "browserExposedReleaseConfiguration": false
  },
  "forbiddenProductionManagers": ["systemd", "standalone-pm2", "host-crontab", "screen-docker-compose"]
}
