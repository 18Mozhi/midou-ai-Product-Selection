{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOps S0 Baota production evidence",
  "type": "object",
  "required": ["schemaVersion", "target", "release", "panelObjects", "health", "heartbeats", "dependencies", "logging", "capturedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {"type": "object", "required": ["host", "domain"], "properties": {"host": {"const": "192.168.1.220"}, "domain": {"const": "midouai.mozhiz.cn"}}},
    "release": {"type": "object", "required": ["commit", "appVersion", "configFingerprint", "migrationVersion"]},
    "panelObjects": {"type": "array", "minItems": 8},
    "health": {"type": "object", "required": ["live", "ready", "version"]},
    "heartbeats": {"type": "object", "required": ["worker", "crawler"]},
    "dependencies": {"type": "object", "required": ["mysqlVersion", "mysqlCharset", "redisLocalOnly"]},
    "logging": {"type": "object", "required": ["panelVisible", "rotationConfigured", "secretScanPassed"]},
    "capturedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
