{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai选品单后端宝塔生产证据",
  "type": "object",
  "required": ["schemaVersion", "target", "release", "panelObjects", "health", "runtime", "dependencies", "logging", "capturedAt"],
  "properties": {
    "schemaVersion": {"const": 2},
    "target": {
      "type": "object",
      "required": ["host", "domain", "deployRoot"],
      "properties": {
        "host": {"const": "192.168.1.220"},
        "domain": {"const": "midouai.mozhiz.cn"},
        "deployRoot": {"const": "/www/wwwroot/ai选品"}
      }
    },
    "release": {"type": "object", "required": ["commit", "appVersion", "configFingerprint", "migrationVersion"]},
    "panelObjects": {"type": "array", "minItems": 5, "maxItems": 5},
    "health": {"type": "object", "required": ["live", "ready", "version"]},
    "runtime": {"type": "object", "required": ["backend", "worker"]},
    "dependencies": {"type": "object", "required": ["mysqlVersion", "mysqlCharset", "redisLocalOnly"]},
    "logging": {"type": "object", "required": ["panelVisible", "rotationConfigured", "secretScanPassed"]},
    "capturedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
