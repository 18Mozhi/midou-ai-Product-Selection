{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOps M07-06 production selection acceptance evidence",
  "type": "object",
  "required": ["schemaVersion", "module", "manager", "topology", "backupServerUsed", "buildSha", "journeyId", "taskId", "inputKind", "inputSha256", "providerCode", "memberRole", "memberCapabilities", "providerConfigurationTouchedByMember", "createApiMs", "acceptedVisibleMs", "terminalMs", "terminalState", "taskStatus", "decisionAction", "decisionRecorded", "evidenceViewed", "requestId", "traceId", "capturedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "module": {"const": "M07-06"},
    "manager": {"const": "baota"},
    "topology": {"const": "single_host_huizhou"},
    "backupServerUsed": {"const": false},
    "buildSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "journeyId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "format": "uuid"},
    "opportunityId": {"type": ["string", "null"]},
    "inputKind": {"enum": ["keyword", "asin", "product_url"]},
    "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "providerCode": {"const": "google_news_search"},
    "memberRole": {"const": "member"},
    "memberCapabilities": {"type": "array", "contains": {"const": "task:create"}},
    "providerConfigurationTouchedByMember": {"const": false},
    "createApiMs": {"type": "integer", "minimum": 0, "maximum": 3000},
    "acceptedVisibleMs": {"type": "integer", "minimum": 0, "maximum": 15000},
    "terminalMs": {"type": "integer", "minimum": 0, "maximum": 180000},
    "terminalState": {"enum": ["result_ready", "succeeded_empty", "blocked", "failed"]},
    "taskStatus": {"type": "string", "minLength": 1},
    "decisionAction": {"enum": ["observe", "reject", "adopt"]},
    "decisionRecorded": {"const": true},
    "evidenceViewed": {"const": true},
    "rawEvidenceId": {"type": ["string", "null"]},
    "blockedReason": {"type": ["string", "null"]},
    "requestId": {"type": "string"},
    "traceId": {"type": "string"},
    "capturedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
