{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOps M07-05 production rollout evidence",
  "type": "object",
  "required": ["schemaVersion", "module", "manager", "topology", "backupServerUsed", "releaseId", "buildSha", "appVersion", "configFingerprint", "migrationVersion", "concurrencyProtection", "publicProbe", "mysqlDurability", "mysqlResourceProfile", "writeProbe", "percentages", "minimumObservationSeconds", "sampleIntervalSeconds", "gates", "automaticStopArmed", "rollbackTarget", "requestId", "traceId", "capturedAt"],
  "properties": {
    "schemaVersion": {"const": 6},
    "module": {"const": "M07-05"},
    "manager": {"const": "baota"},
    "topology": {"const": "single_host_stable_and_candidate"},
    "backupServerUsed": {"const": false},
    "releaseId": {"type": "string", "format": "uuid"},
    "buildSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "appVersion": {"type": "string", "minLength": 1},
    "configFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "migrationVersion": {"const": "0027a_release_rollout_attempts_m07_05.up.sql"},
    "concurrencyProtection": {"type": "object", "required": ["taskTrigger", "lock", "lockName", "lockTimeoutSeconds", "acquired", "attemptHistoryPreserved"], "properties": {"taskTrigger": {"const": "manual_only"}, "lock": {"const": "mysql_session_named_lock"}, "lockName": {"const": "scoutops:m07-05:release-rollout"}, "lockTimeoutSeconds": {"const": 0}, "acquired": {"const": true}, "attemptHistoryPreserved": {"const": true}}, "additionalProperties": false},
    "publicProbe": {"type": "object", "required": ["origin", "connectAddress", "tlsHostnamePreserved", "manager"], "properties": {"origin": {"const": "https://midouai.mozhiz.cn"}, "connectAddress": {"const": "127.0.0.1"}, "tlsHostnamePreserved": {"const": true}, "manager": {"const": "baota_nginx"}}, "additionalProperties": false},
    "mysqlDurability": {"type": "object", "required": ["innodbFlushLogAtTrxCommit", "syncBinlog", "binlogFormat", "productScoutBinlogExcluded", "osCrashDataLossWindowSeconds"], "properties": {"innodbFlushLogAtTrxCommit": {"const": 2}, "syncBinlog": {"const": 1}, "binlogFormat": {"const": "ROW"}, "productScoutBinlogExcluded": {"const": false}, "osCrashDataLossWindowSeconds": {"const": 1}}, "additionalProperties": false},
    "mysqlResourceProfile": {"type": "object", "required": ["innodbBufferPoolBytes", "innodbBufferPoolInstances", "innodbIoCapacity", "innodbIoCapacityMax", "innodbFlushNeighbors", "innodbFlushMethod"], "properties": {"innodbBufferPoolBytes": {"const": 4294967296}, "innodbBufferPoolInstances": {"const": 4}, "innodbIoCapacity": {"const": 1000}, "innodbIoCapacityMax": {"const": 4000}, "innodbFlushNeighbors": {"const": 0}, "innodbFlushMethod": {"const": "O_DIRECT"}}, "additionalProperties": false},
    "writeProbe": {"type": "object", "required": ["path", "signed", "canonicalFields", "proxyRequestIdsExcluded", "candidatePersistenceMatched", "durableStatementsPerSample", "preUpstreamTransportRetryAttempts", "candidateResponsesRemainFailClosed"], "properties": {"path": {"const": "/api/v1/platform/operations/releases/write-probe"}, "signed": {"const": true}, "canonicalFields": {"const": ["timestamp", "nonce", "release_id", "sample_id"]}, "proxyRequestIdsExcluded": {"const": true}, "candidatePersistenceMatched": {"const": true}, "durableStatementsPerSample": {"const": 1}, "preUpstreamTransportRetryAttempts": {"const": 1}, "candidateResponsesRemainFailClosed": {"const": true}}, "additionalProperties": false},
    "percentages": {"const": [5, 25, 100]},
    "minimumObservationSeconds": {"type": "integer", "minimum": 1800},
    "sampleIntervalSeconds": {"const": 1},
    "gates": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["percent", "observeSeconds", "sampleCount", "errorRate", "readP95", "writeP95", "asyncLag", "readSamples", "writeSamples", "durableWriteSamples", "preUpstreamTransportAborts", "writeDeliveryFailures"],
        "properties": {
          "percent": {"type": "integer", "enum": [5, 25, 100]},
          "observeSeconds": {"type": "integer", "minimum": 1800},
          "sampleCount": {"type": "integer", "minimum": 10},
          "errorRate": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
          "readP95": {"type": "integer", "minimum": 0, "maximum": 300},
          "writeP95": {"type": "integer", "minimum": 0, "maximum": 600},
          "asyncLag": {"type": "integer", "minimum": 0, "maximum": 60},
          "readSamples": {"type": "integer", "minimum": 5},
          "writeSamples": {"type": "integer", "minimum": 5},
          "durableWriteSamples": {"type": "integer", "minimum": 5},
          "preUpstreamTransportAborts": {"type": "integer", "minimum": 0},
          "writeDeliveryFailures": {"const": 0}
        }
      }
    },
    "automaticStopArmed": {"const": true},
    "rollbackTarget": {"type": "object", "required": ["sameHost", "stablePort"], "properties": {"sameHost": {"const": true}, "stablePort": {"type": "integer", "enum": [4101, 4103]}}},
    "requestId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "capturedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
