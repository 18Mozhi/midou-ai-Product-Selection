{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"ScoutOps M08-03 BaoTa MySQL single-primary production evidence","type":"object",
  "required":["schemaVersion","module","status","buildSha","manager","mode","engine","region","durability","runtime","recovery","singlePrimary","replicaEnabled","loadBalancingEnabled","backupServerUsed","capacityClaim","capturedAt"],
  "properties":{
    "schemaVersion":{"const":1},"module":{"const":"M08-03"},"status":{"const":"ready"},"buildSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"manager":{"const":"baota"},"mode":{"const":"single_primary"},"engine":{"type":"string","pattern":"^5\\.7\\."},"region":{"const":"惠州"},
    "durability":{"type":"object","required":["logBinEnabled","binlogFormat","productDatabaseBinlogExcluded","innodbFlushLogAtTrxCommit","syncBinlog","masterStatusAvailable"],"properties":{"logBinEnabled":{"const":true},"binlogFormat":{"const":"ROW"},"productDatabaseBinlogExcluded":{"const":false},"innodbFlushLogAtTrxCommit":{"const":2},"syncBinlog":{"const":1},"masterStatusAvailable":{"const":true}},"additionalProperties":false},
    "runtime":{"type":"object","required":["connectionUsageBasisPoints","dataUsageBasisPoints","slowQueriesPerMinute","bufferPoolHitRateBasisPoints","apiReadiness","workerReady","crawlerReady"],"properties":{"connectionUsageBasisPoints":{"type":"integer","minimum":0,"maximum":8999},"dataUsageBasisPoints":{"type":"integer","minimum":0,"maximum":8999},"slowQueriesPerMinute":{"type":"number","minimum":0,"exclusiveMaximum":20},"bufferPoolHitRateBasisPoints":{"type":"integer","minimum":0,"maximum":10000},"apiReadiness":{"const":true},"workerReady":{"const":true},"crawlerReady":{"const":true}},"additionalProperties":false},
