    "singlePrimary":{"const":true},"replicaEnabled":{"const":false},"loadBalancingEnabled":{"const":false},"backupServerUsed":{"const":false},"capacityClaim":{"const":"unverified"},"capturedAt":{"type":"string","format":"date-time"}
  },"additionalProperties":false
}
