{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "types": ["vite/client"],
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": "./.web.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
